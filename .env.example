NODE_ENV=development
PORT=3005
APP_BASE_URL=http://localhost:3005
FRONTEND_BASE_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
EMAIL_VERIFICATION_URL=http://localhost:3001/verify-email
PASSWORD_RESET_URL=http://localhost:3001/reset-password

JWT_ACCESS_SECRET=replace-with-auth-service-access-secret
JWT_REFRESH_SECRET=replace-with-auth-service-refresh-secret

EMAIL_FROM=MedSphere <medsphere@noreply.com>
CORE_SERVICE_URL=http://localhost:3007
CORE_SERVICE_URL_DOCKER=http://host.docker.internal:3007
INTERNAL_API_KEY=replace-with-shared-internal-service-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password-without-spaces
RESEND_API_KEY=

POSTGRES_USER=medsphere
POSTGRES_PASSWORD=medsphere
POSTGRES_DB=auth_service
POSTGRES_PORT=5432

# Local development uses localhost. Docker compose injects the postgres service host.
DATABASE_URL=postgresql://medsphere:medsphere@localhost:5432/auth_service
# Inside Docker: postgresql://medsphere:medsphere@postgres:5432/auth_service

AUTH_SERVICE_PORT=3005
